{
  "checks": {
    "frontend": [
      "browser smoke evidence required"
    ],
    "generic": [
      "git diff --check"
    ],
    "node": [
      "npm test",
      "npm run lint"
    ],
    "python": [
      "python -m pytest -q",
      "python -m ruff check ."
    ],
    "terraform": [
      "terraform fmt -check",
      "terraform validate",
      "terraform plan -detailed-exitcode"
    ]
  },
  "hard_gates": {
    "compile_failure_cannot_win": true,
    "failed_checks_cannot_win_if_any_pass": true,
    "security_critical_cannot_win": true
  },
  "pairwise": {
    "default_mode": "all_pairs",
    "initial_elo": 1500,
    "judge_count": 1,
    "k_factor": 32,
    "max_all_pairs_variants": 5
  },
  "runner": {
    "approval_mode": "prompt",
    "default_judge_runner": "heuristic",
    "default_runner": "manual",
    "max_parallel_runs": 1,
    "sandbox": "workspace-write",
    "timeout_sec": 900
  },
  "safety": {
    "allow_network_commands": false,
    "blocked_command_patterns": [
      "\\brm\\s+-rf\\s+(/|\\.|~|\\$HOME)",
      "\\bgit\\s+reset\\s+--hard\\b",
      "\\bgit\\s+clean\\s+-fdx\\b",
      "\\bterraform\\s+(apply|destroy)\\b",
      "\\btofu\\s+(apply|destroy)\\b",
      "\\bkubectl\\s+delete\\b",
      "\\bhelm\\s+(uninstall|delete)\\b",
      "\\bdocker\\s+system\\s+prune\\b",
      "\\bdocker\\s+volume\\s+prune\\b",
      "\\bchmod\\s+-R\\s+777\\b",
      "\\bcurl\\b.*\\|\\s*(bash|sh)",
      "\\bwget\\b.*\\|\\s*(bash|sh)",
      "\\bdd\\b.*\\bof=/dev/",
      "\\bmkfs\\b",
      "\\bfdisk\\b"
    ],
    "secret_path_patterns": [
      "(^|/)\\.env($|\\.)",
      "secret",
      "credential",
      "private[_-]?key",
      "id_rsa",
      "id_ed25519"
    ]
  },
  "scoring_profiles": {
    "architecture": {
      "blast_radius": 15,
      "checks": 25,
      "diff_minimality": 5,
      "docs": 10,
      "elo": 20,
      "maintainability": 25,
      "safety": 5,
      "tests": 15
    },
    "balanced": {
      "blast_radius": 15,
      "checks": 35,
      "diff_minimality": 10,
      "docs": 5,
      "elo": 20,
      "maintainability": 10,
      "safety": 10,
      "tests": 15
    },
    "minimal_risk": {
      "blast_radius": 20,
      "checks": 30,
      "diff_minimality": 20,
      "docs": 0,
      "elo": 20,
      "maintainability": 5,
      "safety": 5,
      "tests": 20
    }
  },
  "variants": [
    "minimal_patch",
    "test_first",
    "clean_boundary",
    "maintainability_refactor"
  ],
  "version": 1,
  "worktrees": {
    "location": "../.shadow-pr-arena-worktrees/{repo_name}",
    "refuse_dirty_repo_by_default": true
  }
}
