--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,16 @@
+from __future__ import annotations
+
+import pytest
+
+from shadow_pr_arena_mcp import __version__
+from shadow_pr_arena_mcp.cli import main
+
+
+def test_version_flag_prints_package_version(capsys: pytest.CaptureFixture[str]):
+    with pytest.raises(SystemExit) as excinfo:
+        main(["--version"])
+
+    assert excinfo.value.code == 0
+    captured = capsys.readouterr()
+    assert captured.out == f"shadow-pr-arena {__version__}\n"
+    assert captured.err == ""
