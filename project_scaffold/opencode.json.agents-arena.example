{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "agents-arena": {
      "type": "local",
      "command": ["python", "-m", "agents_arena_mcp.server"],
      "enabled": true,
      "environment": {
        "AGENTS_ARENA_ROOT": "."
      }
    }
  },
  "agent": {
    "arena-implementer": {
      "mode": "primary",
      "prompt": "{file:.opencode/agents/arena-implementer.md}",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "ask"
      }
    },
    "arena-judge": {
      "mode": "primary",
      "prompt": "{file:.opencode/agents/arena-judge.md}",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "deny"
      }
    }
  }
}
